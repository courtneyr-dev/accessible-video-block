{
    "name": "courtneyr/accessible-video-block",
    "description": "Gutenberg block for Joe Dolson's Able Player plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CourtneyR\\AccessibleVideoBlock\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CourtneyR\\AccessibleVideoBlock\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
